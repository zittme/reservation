<query id="insertSettlementItem" action="insert">
	<tables>
		<table name="reservation_settlement_item" />
	</tables>
	<columns>
		<column name="item_srl" var="item_srl" notnull="notnull" />
		<column name="settlement_srl" var="settlement_srl" notnull="notnull" />
		<column name="booking_srl" var="booking_srl" notnull="notnull" />
		<column name="resource_srl" var="resource_srl" default="0" />
		<column name="amount" var="amount" default="0" />
		<column name="share_rate" var="share_rate" default="0" />
		<column name="share_amount" var="share_amount" default="0" />
		<column name="service_date" var="service_date" />
		<column name="regdate" var="regdate" />
	</columns>
</query>
