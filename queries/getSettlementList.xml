<query id="getSettlementList" action="select">
	<tables>
		<table name="reservation_settlement" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="module_srl" var="module_srl" />
		<condition operation="equal" column="staff_srl" var="staff_srl" pipe="and" />
		<condition operation="equal" column="status" var="status" pipe="and" />
		<condition operation="more" column="period_from" var="from_date" pipe="and" />
		<condition operation="less" column="period_to" var="to_date" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="settlement_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
