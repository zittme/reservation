<query id="insertStaff" action="insert">
	<tables>
		<table name="reservation_staff" />
	</tables>
	<columns>
		<column name="staff_srl" var="staff_srl" notnull="notnull" />
		<column name="module_srl" var="module_srl" default="0" />
		<column name="branch_srl" var="branch_srl" default="0" />
		<column name="member_srl" var="member_srl" default="0" />
		<column name="name" var="name" notnull="notnull" />
		<column name="position" var="position" />
		<column name="summary" var="summary" />
		<column name="content" var="content" />
		<column name="thumb" var="thumb" />
		<column name="share_rate" var="share_rate" default="0" />
		<column name="status" var="status" default="active" />
		<column name="list_order" var="list_order" default="0" />
		<column name="regdate" var="regdate" />
		<column name="last_update" var="last_update" />
	</columns>
</query>
