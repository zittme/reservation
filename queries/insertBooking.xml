<query id="insertBooking" action="insert">
	<tables>
		<table name="reservation_booking" />
	</tables>
	<columns>
		<column name="booking_srl" var="booking_srl" notnull="notnull" />
		<column name="booking_code" var="booking_code" notnull="notnull" />
		<column name="module_srl" var="module_srl" default="0" />
		<column name="resource_srl" var="resource_srl" notnull="notnull" />
		<column name="slot_srl" var="slot_srl" notnull="notnull" />
		<column name="member_srl" var="member_srl" default="0" />
		<column name="booker_name" var="booker_name" notnull="notnull" />
		<column name="booker_phone" var="booker_phone" />
		<column name="booker_email" var="booker_email" />
		<column name="guest_password" var="guest_password" />
		<column name="person_count" var="person_count" default="1" />
		<column name="amount" var="amount" default="0" />
		<column name="pay_order_srl" var="pay_order_srl" default="0" />
		<column name="status" var="status" notnull="notnull" />
		<column name="hold_expires" var="hold_expires" />
		<column name="memo" var="memo" />
		<column name="admin_memo" var="admin_memo" />
		<column name="extra_vars" var="extra_vars" />
		<column name="ipaddress" var="ipaddress" />
		<column name="regdate" var="regdate" />
		<column name="confirmed_date" var="confirmed_date" />
		<column name="cancelled_date" var="cancelled_date" />
	</columns>
</query>
