<query id="getCreditLogs" action="select">
	<tables>
		<table name="reservation_credit_log" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" />
		<condition operation="equal" column="booking_srl" var="booking_srl" pipe="and" />
		<condition operation="equal" column="type" var="type" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="log_srl" order="desc" />
		<list_count var="list_count" default="50" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
