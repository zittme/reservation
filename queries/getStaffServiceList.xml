<query id="getStaffServiceList" action="select">
	<tables>
		<table name="reservation_staff_service" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="staff_srl" var="staff_srl" />
		<condition operation="equal" column="resource_srl" var="resource_srl" pipe="and" />
		<condition operation="equal" column="is_active" var="is_active" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="map_srl" order="asc" />
	</navigation>
</query>
