		<column name="booking_srl" var="booking_srl" notnull="notnull" />
		<column name="agreement_type" var="agreement_type" notnull="notnull" />
		<column name="agreement_version" var="agreement_version" />
		<column name="agreed" var="agreed" default="Y" />
		<column name="ipaddress" var="ipaddress" />
		<column name="regdate" var="regdate" />
	</columns>
</query>
