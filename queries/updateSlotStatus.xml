<query id="updateSlotStatus" action="update">
	<!-- 슬롯 수동 마감/해제 -->
	<tables>
		<table name="reservation_slot" />
	</tables>
	<columns>
		<column name="status" var="status" notnull="notnull" />
	</columns>
	<conditions>
		<condition operation="equal" column="slot_srl" var="slot_srl" required="true" />
	</conditions>
</query>
