<query id="getMyCouponIssues" action="select">
	<!-- 회원의 미사용 발급 쿠폰 -->
	<tables>
		<table name="reservation_coupon_issue" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" required="true" />
		<!-- 미사용 여부(booking_srl = 0)는 여기서 거르지 않는다. 0 은 빈 값으로 취급돼
		     조건이 통째로 빠질 수 있다. 쓴 쿠폰은 모델에서 걸러 낸다 -->
	</conditions>
	<navigation>
		<index var="sort_index" default="issue_srl" order="desc" />
		<list_count var="list_count" default="100" />
	</navigation>
</query>
