<query id="getCouponIssueList" action="select">
	<!-- 관리자: 쿠폰별 발급 이력 -->
	<tables>
		<table name="reservation_coupon_issue" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="coupon_srl" var="coupon_srl" />
		<condition operation="equal" column="member_srl" var="member_srl" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="issue_srl" order="desc" />
		<list_count var="list_count" default="50" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
