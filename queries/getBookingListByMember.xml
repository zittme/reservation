<query id="getBookingListByMember" action="select">
	<tables>
		<table name="reservation_booking" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" required="true" />
	</conditions>
	<navigation>
		<index var="sort_index" default="booking_srl" order="desc" />
		<list_count var="list_count" default="50" />
	</navigation>
</query>
