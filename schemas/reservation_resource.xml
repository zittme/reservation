<table name="reservation_resource">
	<column name="resource_srl" type="bigint" notnull="notnull" primarykey="primarykey" />
	<column name="module_srl" type="bigint" notnull="notnull" default="0" index="idx_module_srl" />
	<column name="title" type="varchar" size="250" notnull="notnull" />
	<column name="summary" type="varchar" size="250" />
	<column name="content" type="text" />
	<column name="thumb" type="varchar" size="250" />
	<!-- 슬롯 기본 정원. 1 = 1:1 예약, N = 클래스형 -->
	<column name="capacity_default" type="int" notnull="notnull" default="1" />
	<!-- 기본 이용시간(분) = 슬롯 간격의 기본값 -->
	<column name="duration" type="int" notnull="notnull" default="60" />
	<!-- 0 이면 무료 예약 -->
	<column name="price" type="bigint" notnull="notnull" default="0" />
	<column name="require_payment" type="char" size="1" notnull="notnull" default="N" />
	<!-- 준비·정리 시간(분) -->
	<column name="buffer_before" type="int" notnull="notnull" default="0" />
	<column name="buffer_after" type="int" notnull="notnull" default="0" />
	<!-- 며칠 뒤까지 / 몇 분 전까지 예약 가능 -->
	<column name="max_advance_days" type="int" notnull="notnull" default="90" />
	<column name="min_lead_minutes" type="int" notnull="notnull" default="60" />
	<column name="cancel_deadline_hours" type="int" notnull="notnull" default="24" />
	<!--
	  점유 방식. slot = 미리 찍어 둔 슬롯을 나눠 쓰는 정원제(강습, 회의실).
	  staff = 담당자의 빈 시간을 계산해 잡는 방식(미용실, 상담). 뒤쪽은 슬롯을 쓰지 않는다.
	-->
	<column name="booking_mode" type="varchar" size="10" notnull="notnull" default="slot" />
	<!-- 시술 분류. 컷, 펌 같은 묶음 이름을 그대로 적는다 -->
	<column name="category" type="varchar" size="100" />
	<!-- none = 결제 없음 / deposit = 예약금만 / full = 전액 선결제 -->
	<column name="pay_mode" type="varchar" size="10" notnull="notnull" default="none" />
	<!-- pay_mode 가 deposit 일 때 받을 금액 -->
	<column name="deposit_amount" type="bigint" notnull="notnull" default="0" />
	<column name="status" type="varchar" size="20" notnull="notnull" default="open" index="idx_status" />
	<column name="list_order" type="bigint" notnull="notnull" default="0" index="idx_list_order" />
	<column name="regdate" type="char" size="14" index="idx_regdate" />
	<column name="last_update" type="char" size="14" />
</table>
