<table name="reservation_staff">
	<column name="staff_srl" type="bigint" notnull="notnull" primarykey="primarykey" />
	<column name="module_srl" type="bigint" notnull="notnull" default="0" index="idx_module_srl" />
	<!--
	  이 담당자가 일하는 지점. 지점 모듈의 branch_srl 을 가리킨다.
	  0 이면 지점을 가리지 않는다. 지점 모듈이 없는 사이트에서도 그대로 동작한다.
	-->
	<column name="branch_srl" type="bigint" notnull="notnull" default="0" index="idx_branch_srl" />
	<!-- 담당자 본인 계정. 0 이면 로그인 연결 없음 -->
	<column name="member_srl" type="bigint" notnull="notnull" default="0" index="idx_member_srl" />
	<column name="name" type="varchar" size="100" notnull="notnull" />
	<!-- 직급 표기. 원장, 실장, 디자이너 등 -->
	<column name="position" type="varchar" size="100" />
	<column name="summary" type="varchar" size="250" />
	<column name="content" type="text" />
	<column name="thumb" type="varchar" size="250" />
	<!-- 기본 배분율. 만분율 정수다. 45.5% 는 4550 -->
	<column name="share_rate" type="int" notnull="notnull" default="0" />
	<column name="status" type="varchar" size="20" notnull="notnull" default="active" index="idx_status" />
	<column name="list_order" type="bigint" notnull="notnull" default="0" index="idx_list_order" />
	<column name="regdate" type="char" size="14" index="idx_regdate" />
	<column name="last_update" type="char" size="14" />
</table>
